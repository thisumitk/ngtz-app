{
  "name": "ngtz-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.400.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "recharts": {
      "react-is": "$react"
    }
  }
}
